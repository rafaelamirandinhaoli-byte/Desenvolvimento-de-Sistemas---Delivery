def menu():
    while True:
        print("\n===== SISTEMA DELIVERY =====")
        print("1 - Cliente")
        print("2 - Estabelecimento")
        print("3 - Entregador")
        print("4 - Pedido")
        print("0 - Sair")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            menu_cliente()

        elif opcao == "2":
            menu_estabelecimento()

        elif opcao == "3":
            menu_entregador()

        elif opcao == "4":
            menu_pedido()

        elif opcao == "0":
            print("Sistema encerrado.")
            break

        else:
            print("Opção inválida!")


