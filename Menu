# ================= LISTAS =================

clientes = []
estabelecimentos = []
entregadores = []
pedidos = []


# ================= MENU PRINCIPAL =================

def menu():
    while True:
        print("\n===== SISTEMA DELIVERY =====")
        print("1 - Cliente")
        print("2 - Estabelecimento")
        print("3 - Entregador")
        print("4 - Pedido")
        print("5 - Rota do Pedido")
        print("0 - Sair")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            menu_cliente()

        elif opcao == "2":
            menu_estabelecimento()

        elif opcao == "3":
            menu_entregador()

        elif opcao == "4":
            menu_pedido()

        elif opcao == "5":
            menu_rota()

        elif opcao == "0":
            print("Sistema encerrado.")
            break

        else:
            print("Opção inválida!")


# ================= MENU CLIENTE =================

def menu_cliente():
    while True:
        print("\n--- MENU CLIENTE ---")
        print("1 - Cadastrar cliente")
        print("2 - Listar clientes")
        print("0 - Voltar")

        opcao = input("Escolha: ")

        if opcao == "1":

            nome = input("Nome do cliente: ")
            telefone = input("Telefone: ")
            endereco = input("Endereço: ")

            cliente = {
                "nome": nome,
                "telefone": telefone,
                "endereco": endereco
            }

            clientes.append(cliente)

            print("Cliente cadastrado!")

        elif opcao == "2":

            if len(clientes) == 0:
                print("Nenhum cliente cadastrado.")

            else:
                print("\n===== CLIENTES =====")

                for i, cliente in enumerate(clientes):
                    print(f"""
Cliente {i+1}
Nome: {cliente['nome']}
Telefone: {cliente['telefone']}
Endereço: {cliente['endereco']}
""")

        elif opcao == "0":
            break

        else:
            print("Opção inválida!")


