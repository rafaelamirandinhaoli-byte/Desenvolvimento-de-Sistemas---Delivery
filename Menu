# ================= MENU PEDIDO =================

def menu_pedido():
    while True:
        print("\n--- MENU PEDIDO ---")
        print("1 - Criar pedido")
        print("2 - Listar pedidos")
        print("3 - Finalizar pedido")
        print("0 - Voltar")

        opcao = input("Escolha: ")

        # ===== CRIAR PEDIDO =====

        if opcao == "1":

            if len(clientes) == 0:
                print("Cadastre um cliente primeiro.")
                continue

            if len(estabelecimentos) == 0:
                print("Cadastre um estabelecimento primeiro.")
                continue

            print("\n===== CLIENTES =====")

            for i, cliente in enumerate(clientes):
                print(f"{i+1} - {cliente['nome']}")

            indice_cliente = int(input("Escolha o cliente: ")) - 1

            print("\n===== ESTABELECIMENTOS =====")

            for i, est in enumerate(estabelecimentos):
                print(f"{i+1} - {est['nome']}")

            indice_est = int(input("Escolha o estabelecimento: ")) - 1

            descricao = input("Descrição do pedido: ")

            pedido = {
                "cliente": clientes[indice_cliente]["nome"],
                "endereco_cliente": clientes[indice_cliente]["endereco"],

                "estabelecimento": estabelecimentos[indice_est]["nome"],
                "endereco_estabelecimento": estabelecimentos[indice_est]["endereco"],

                "descricao": descricao,
                "status": "Aberto"
            }

            pedidos.append(pedido)

            print("Pedido criado!")

        # ===== LISTAR PEDIDOS =====

        elif opcao == "2":

            if len(pedidos) == 0:
                print("Nenhum pedido cadastrado.")

            else:
                print("\n===== PEDIDOS =====")

                for i, pedido in enumerate(pedidos):
                    print(f"""
Pedido {i+1}
Cliente: {pedido['cliente']}
Estabelecimento: {pedido['estabelecimento']}
Descrição: {pedido['descricao']}
Status: {pedido['status']}
""")

        # ===== FINALIZAR PEDIDO =====

        elif opcao == "3":

            if len(pedidos) == 0:
                print("Nenhum pedido disponível.")
                continue

            print("\n===== PEDIDOS =====")

            for i, pedido in enumerate(pedidos):
                print(f"{i+1} - {pedido['cliente']} | {pedido['status']}")

            indice = int(input("Escolha o pedido: ")) - 1

            pedidos[indice]["status"] = "Finalizado"

            print("Pedido finalizado!")

        elif opcao == "0":
            break

        else:
            print("Opção inválida!")


# ================= MENU ROTA =================

def menu_rota():

    if len(pedidos) == 0:
        print("Nenhum pedido cadastrado.")
        return

    print("\n===== ROTAS DOS PEDIDOS =====")

    for i, pedido in enumerate(pedidos):

        print(f"""
Pedido {i+1}

Restaurante:
{pedido['estabelecimento']}
Endereço:
{pedido['endereco_estabelecimento']}

Destino:
{pedido['cliente']}
Endereço:
{pedido['endereco_cliente']}

Status:
{pedido['status']}
""")


# ================= INICIAR SISTEMA =================

menu()
