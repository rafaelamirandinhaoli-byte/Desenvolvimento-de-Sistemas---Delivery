# ================= PEDIDOS =================

def criar_pedido():

    cliente = input("Cliente: ")
    endereco_cliente = input("Endereço do cliente: ")

    estabelecimento = input("Estabelecimento: ")
    endereco_estabelecimento = input("Endereço estabelecimento: ")

    descricao = input("Descrição do pedido: ")

    dados = {
        "cliente": cliente,
        "endereco_cliente": endereco_cliente,
        "estabelecimento": estabelecimento,
        "endereco_estabelecimento": endereco_estabelecimento,
        "descricao": descricao,
        "status": "Aberto"
    }

    supabase.table("pedidos").insert(dados).execute()

    print("Pedido criado!")


def listar_pedidos():

    resposta = supabase.table("pedidos").select("*").execute()

    pedidos = resposta.data

    print("\n===== PEDIDOS =====")

    for pedido in pedidos:
        print(pedido)


def finalizar_pedido():

    id_pedido = int(input("ID do pedido: "))

    supabase.table("pedidos") \
        .update({"status": "Finalizado"}) \
        .eq("id", id_pedido) \
        .execute()

    print("Pedido finalizado!")


# ================= MENU =================

while True:

    print("\n===== DELIVERY =====")
    print("1 - Cadastrar cliente")
    print("2 - Listar clientes")

    print("3 - Cadastrar estabelecimento")
    print("4 - Listar estabelecimentos")

    print("5 - Cadastrar entregador")
    print("6 - Listar entregadores")

    print("7 - Criar pedido")
    print("8 - Listar pedidos")
    print("9 - Finalizar pedido")

    print("0 - Sair")

    opcao = input("Escolha: ")

    if opcao == "1":
        cadastrar_cliente()

    elif opcao == "2":
        listar_clientes()

    elif opcao == "3":
        cadastrar_estabelecimento()

    elif opcao == "4":
        listar_estabelecimentos()

    elif opcao == "5":
        cadastrar_entregador()

    elif opcao == "6":
        listar_entregadores()

    elif opcao == "7":
        criar_pedido()

    elif opcao == "8":
        listar_pedidos()

    elif opcao == "9":
        finalizar_pedido()

    elif opcao == "0":
        print("Sistema encerrado.")
        break

    else:
        print("Opção inválida!")




































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































