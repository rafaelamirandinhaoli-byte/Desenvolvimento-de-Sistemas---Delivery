# =========================
# MENU PEDIDO
# =========================

def menu_pedido():
    while True:
        print("\n--- MENU PEDIDO ---")
        print("1 - Criar pedido")
        print("2 - Listar pedidos")
        print("0 - Voltar")

        opcao = input("Escolha: ")

        if opcao == "1":

            if len(clientes) == 0 or len(estabelecimentos) == 0:
                print("Cadastre clientes e estabelecimentos primeiro!")
                continue

            print("\nClientes:")
            for i, cliente in enumerate(clientes):
                print(f"{i} - {cliente}")

            indice_cliente = int(input("Escolha o cliente: "))

            print("\nEstabelecimentos:")
            for i, est in enumerate(estabelecimentos):
                print(f"{i} - {est}")

            indice_est = int(input("Escolha o estabelecimento: "))

            pedido = Pedido(
                clientes[indice_cliente],
                estabelecimentos[indice_est]
            )

            pedidos.append(pedido)

            print("Pedido criado!")

        elif opcao == "2":
            print("\nLISTA DE PEDIDOS")

            for pedido in pedidos:
                print(pedido)

        elif opcao == "0":
            break

        else:
            print("Opção inválida!")


# =========================
# MENU PRINCIPAL
# =========================

def menu():
    while True:
        print("\n===== DELIVERY =====")
        print("1 - Cliente")
        print("2 - Estabelecimento")
        print("3 - Entregador")
        print("4 - Pedido")
        print("0 - Sair")

        opcao = input("Escolha: ")

        if opcao == "1":
            menu_cliente()

        elif opcao == "2":
            menu_estabelecimento()

        elif opcao == "3":
            menu_entregador()

        elif opcao == "4":
            menu_pedido()

        elif opcao == "0":
            print("Sistema encerrado.")
            break

        else:
            print("Opção inválida!")


# EXECUTAR
menu()
